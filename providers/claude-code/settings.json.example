{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/providers/claude-code/hooks/check_write_path.py\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/providers/claude-code/hooks/check_write_path.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "ToolSearch",
      "mcp__atlassian__search",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__getConfluencePage",
      "mcp__atlassian__getConfluenceSpaces",
      "mcp__atlassian__getPagesInConfluenceSpace",
      "mcp__atlassian__searchConfluenceUsingCql",
      "mcp__atlassian__getConfluencePageDescendants",
      "mcp__atlassian__getVisibleJiraProjects",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__atlassian__lookupJiraAccountId",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__fetchAtlassian",
      "mcp__atlassian__searchAtlassian",
      "mcp__atlassian__getJiraIssueRemoteIssueLinks",
      "mcp__atlassian__getJiraProjectIssueTypesMetadata",
      "mcp__atlassian__getConfluencePageFooterComments",
      "mcp__atlassian__getConfluencePageInlineComments",
      "mcp__atlassian__getConfluenceCommentChildren",
      "mcp__atlassian__getTransitionsForJiraIssue",
      "mcp__atlassian__getJiraIssueTypeMetaWithFields",
      "mcp__claude_ai_Gmail__gmail_search_messages",
      "mcp__claude_ai_Gmail__gmail_read_message",
      "mcp__claude_ai_Gmail__gmail_read_thread",
      "mcp__claude_ai_Gmail__gmail_get_profile",
      "mcp__claude_ai_Google_Calendar__gcal_list_events",
      "mcp__claude_ai_Google_Calendar__gcal_get_event",
      "mcp__claude_ai_Google_Calendar__gcal_list_calendars",
      "mcp__claude_ai_Google_Calendar__gcal_find_my_free_time",
      "mcp__pipedream__gmail-send-email",
      "mcp__pipedream__google_drive-find-file",
      "mcp__pipedream__google_drive-find-folder",
      "mcp__pipedream__google_drive-find-spreadsheets",
      "mcp__pipedream__google_drive-list-files",
      "mcp__pipedream__google_drive-get-file-by-id",
      "mcp__pipedream__google_drive-get-folder-id-for-path",
      "mcp__pipedream__google_drive-download-file",
      "mcp__pipedream__google_drive-search-shared-drives",
      "mcp__pipedream__google_drive-get-shared-drive"
    ],
    "deny": [
      "Bash",
      "Agent",
      "mcp__claude_ai_Gmail__gmail_create_draft",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__addCommentToJiraIssue",
