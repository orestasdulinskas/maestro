# Maestro environment template.
#
# Copy to `.env` (gitignored) and fill in your values. For cloud runs, store
# these in AWS Secrets Manager under `maestro/mattermost` as a JSON blob — see
# scheduling/claude-routines.md.

# ── Mattermost (optional — urgent-nudge channel) ────────────────
# If unset, runner/maestro.py mattermost stages but does not deliver.
MATTERMOST_BASE_URL=https://chat.example.com
MATTERMOST_BOT_TOKEN=
MATTERMOST_BOT_USER_ID=
MATTERMOST_BOT_USERNAME=
MATTERMOST_USER_ID=
MATTERMOST_USERNAME=
# Channel the bot posts to. Bot must be a member. Each Maestro install should
# have its own dedicated channel (don't share across multiple agents on the
# same bot account).
MATTERMOST_CHANNEL_ID=

# ── Cognee / OpenAI (optional — semantic memory recall) ─────────
# Only needed if you populated lib/cognee-venv. Without this, prompts/heartbeat.md
# Step 1 simply skips the "Recalled Memories" injection.
OPENAI_API_KEY=
MAESTRO_COGNEE_MODEL=gpt-4o-mini

# ── State backend (cloud-only) ──────────────────────────────────
# Default: s3. Set to "local" to keep state under ~/.maestro/ instead.
MAESTRO_STATE_BACKEND=s3
MAESTRO_STATE_BUCKET=maestro-state-yourname
MAESTRO_SECRETS_PREFIX=maestro/
AWS_REGION=us-east-1
AWS_PROFILE=default

# ── Runner behavior ─────────────────────────────────────────────
# Set MAESTRO_DRY_SEND=1 to stage email/Mattermost without delivering.
# Used during the dry-send run in the cloud-routine smoke test sequence.
# MAESTRO_DRY_SEND=1

# Set MAESTRO_MATTERMOST_FALLBACK=1 to raise the per-run cap from 2 to 4.
# The heartbeat prompt sets this dynamically when email is degraded.
# MAESTRO_MATTERMOST_FALLBACK=1
